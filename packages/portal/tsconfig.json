{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-native",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "rootDir": ".",
    "composite": true
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["node_modules", "lib"]
}
